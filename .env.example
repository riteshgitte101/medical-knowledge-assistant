# Medical Knowledge Assistant — Environment Variables
#
# This file shows which environment variables the project will need.
# Copy this file to .env and fill in your actual values.
# Never commit your real .env file to version control.
#
# The specific model provider (OpenAI, Google, etc.) has not been
# decided yet. Update these placeholders once we choose a provider.

# API key for the language model provider
# LLM_API_KEY=your_api_key_here

# API key for the embedding model provider (may be the same provider)
# EMBEDDING_API_KEY=your_api_key_here
