# Environment variables (contains API keys)
.env
.env.*
# Allow the example template to be tracked in Git
!.env.example

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Distribution and packaging
dist/
build/
*.egg-info/

# Uploaded documents (PDFs will be added by the user, not tracked in Git)
documents/*.pdf

# Uploads directory (if created later)
uploads/
